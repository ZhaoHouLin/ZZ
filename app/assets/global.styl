// nuxt.config 的 additionalData 只注入 SFC 的 <style>，css 陣列裡的檔案要自己 import
@import './style.styl'

@font-face
  font-family 'Pixel'
  src url('./fonts/Advanced_Pixel-7.woff') format('woff')
  font-display swap

@font-face
  font-family 'Digital'
  src url('./fonts/Digital-7.woff') format('woff')
  font-display swap

*
  box-sizing border-box
  margin 0
  padding 0

html
  background-color colorPrimary
  color colorSecondary
  font-family fontBody
  font-size 16px
  -webkit-font-smoothing antialiased
  -webkit-overflow-scrolling touch

body
  min-height 100vh
  overflow-x hidden

body::-webkit-scrollbar
  display none

a
  color inherit
  text-decoration none

button
  font inherit
  color inherit
  background none
  border 0

::selection
  background-color colorAccent
  color colorPrimary

// 只有精準指標（滑鼠）才隱藏系統游標，交給 TheCursor
@media (pointer: fine)
  body, a, button
    cursor none

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration .01ms !important
    animation-iteration-count 1 !important
    transition-duration .01ms !important

// 有錨點的區塊都是 SectionBg 的定位容器；isolation 讓背景的 z-index -1 留在區塊內
section[id]
  position relative
  isolation isolate
