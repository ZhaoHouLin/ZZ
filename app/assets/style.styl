// 只放變數與 mixin（會注入每個元件的 stylus），不要放會輸出 CSS 的規則

flex(juc=center,ali=center,direction=row)
  display flex
  justify-content juc
  align-items ali
  flex-direction direction

pos(l=50%,t=l)
  position absolute
  left l
  top t

size(w=100%,h=w)
  width w
  height h

outlineSpace = 1.4rem

colorPrimary = #050505
colorSecondary = #f2f2f2
colorAccent = #f5a623
colorMuted = rgba(255,255,255,.45)
colorLine = rgba(255,255,255,.16)

fontPixel = 'Pixel', 'Courier New', monospace
fontDigital = 'Digital', 'Courier New', monospace
fontBody = 'Noto Sans TC', '微軟正黑體', 'Microsoft JhengHei', system-ui, sans-serif

breakMobile = 768px

// 一頁式各區塊共用的標題列：編號 + 像素字標題 + 靠右的數量
sectionHead()
  display flex
  justify-content flex-start
  align-items baseline
  gap 1rem
  margin-bottom 2rem
  padding-bottom 1rem
  border-bottom 1px solid colorLine
  .sec-idx, .sec-count
    font-family fontDigital
    font-size 1.2rem
  .sec-idx
    color colorAccent
  .sec-count
    margin-left auto
    color colorMuted
  h2
    font-family fontPixel
    font-size 2.6rem
    line-height 1
    font-weight 400
    text-transform uppercase
